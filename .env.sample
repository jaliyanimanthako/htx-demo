# Copy to .env and fill in — .env is git-ignored. Every script loads it automatically.

# ── Self-hosted models on the GPU server (the main setup) ─────────────────────
# LocateAnything server (server/serve_locate.sh)
LOCATE_URL=http://<gpu-server-ip>:8020
# Qwen vLLM server (server/serve_qwen.sh) — used by exit_monitor.py, extinguisher_monitor.py,
# locate_live.py and the backend. Or QWEN_URL=openrouter to use the hosted OpenRouter API
# instead (needs OPENROUTER_API_KEY below; model: QWEN_MODEL, default qwen/qwen3-vl-8b-instruct)
QWEN_URL=http://<gpu-server-ip>:8010/v1
# QWEN_MODEL=qwen/qwen3-vl-8b-instruct
# Or name your Qwen servers and switch with: python qwen_server.py <name>
# (writes QWEN_URL=<name> above; "openrouter" is built in; one run: --qwen-url <name>)
# QWEN_URL_GPU=http://<gpu-server-ip>:8010/v1
# QWEN_URL_MAC=http://localhost:8000/v1
# Same server for the Qwen-only runners with --provider local
LOCAL_VLM_URL=http://<gpu-server-ip>:8010/v1
LOCAL_VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct

# ── Hosted APIs (optional, for --provider openrouter|qwen|openai) ─────────────
OPENROUTER_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=

# ── GPU server only ──────────────────────────────────────────────────────────
# Hugging Face token (faster downloads; not required for the models used here)
HF_TOKEN=
